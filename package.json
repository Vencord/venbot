{
    "name": "venbot",
    "version": "1.0.0",
    "description": "Discord Bot for the Vencord server",
    "main": "dist/index.js",
    "scripts": {
        "start": "pnpm sql:up & pnpm build && node --enable-source-maps . VENBOT",
        "build": "node scripts/build.mjs",
        "test": "pnpm lint && pnpm testTypes",
        "testTypes": "tsc --noEmit",
        "genTypes": "pnpm sql:types && node scripts/genTypes.mjs",
        "lint": "eslint . --ext .js,.ts",
        "lint:fix": "pnpm lint --fix",
        "sql:shell": "sqlite3 data/db.sqlite3",
        "sql:up": "mkdir -p data && sqlite3 data/db.sqlite3 < sql/create.sql",
        "sql:down": "mkdir -p data && sqlite3 data/db.sqlite3 < sql/drop.sql",
        "sql:types": "kysely-codegen --url data/db.sqlite3",
        "postinstall": "pnpm sql:up && pnpm genTypes"
    },
    "keywords": [],
    "author": "Vendicated <vendicated+npm@riseup.net>",
    "dependencies": {
        "@google/genai": "^2.30.0",
        "@intrnl/xxhash64": "^0.1.2",
        "@napi-rs/canvas": "^1.0.13",
        "better-sqlite3": "^13.0.3",
        "fastify": "^5.12.7",
        "gifenc": "^1.0.3",
        "gifuct-js": "^2.1.2",
        "kysely": "^0.29.7",
        "leven": "^4.1.0",
        "markdown-table": "^3.0.4",
        "oceanic.js": "1.15.0",
        "pako": "^3.0.2",
        "parse-duration": "^2.1.5",
        "sharp": "^0.35.5",
        "tesseract.js": "^7.0.0",
        "toml": "^5.0.1",
        "valibot": "^1.5.0",
        "ws": "^8.22.0"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.6.5",
        "@types/ws": "^8.18.2",
        "@typescript-eslint/parser": "^8.72.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "kysely-codegen": "^0.20.0",
        "pino-pretty": "^13.2.0",
        "tslib": "^2.8.1",
        "type-fest": "^5.10.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.72.0"
    },
    "engines": {
        "node": ">=24"
    }
}
